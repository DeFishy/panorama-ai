# Образец переменных окружения. Скопируйте в .env и заполните.
# Файл .env в репозиторий не коммитим (он в .gitignore).

# PostgreSQL для локальной разработки (compose.yaml).
# Пароль подставляется в URL подключения: используйте только латиницу и цифры.
POSTGRES_USER=panorama
POSTGRES_PASSWORD=change-me
POSTGRES_DB=panorama
POSTGRES_PORT=5432
